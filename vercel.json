{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "crons": [
    {
      "path": "/api/cron/market",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/wallets",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/snapshot",
      "schedule": "0 6 * * *"
    }
  ]
}
