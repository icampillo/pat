{
  "name": "patrimoine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --maxWorkers=1",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:local": "tsx scripts/local-db.ts",
    "db:seed:demo": "tsx prisma/seed.ts",
    "user:create": "tsx scripts/create-user.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "snapshot": "tsx scripts/snapshot.ts",
    "format": "prettier --write src scripts tests prisma/seed.ts *.ts *.mjs *.json *.yaml *.yml",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/backup.ts --restore",
    "wallet:install": "playwright install chromium",
    "wallet:check": "tsx scripts/check-wallet.ts",
    "market:sync": "tsx scripts/sync-market.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.3.3",
    "better-auth": "1.7.5",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.2",
    "csv-stringify": "6.8.3",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.1",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "pg": "8.23.0",
    "playwright": "1.63.0",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "recharts": "3.10.1",
    "sharp": "0.35.4",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@inquirer/prompts": "8.7.2",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.8.1",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
