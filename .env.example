DATABASE_URL=postgresql://patrimoine:CHANGE_ME@127.0.0.1:5432/patrimoine
DATABASE_URL_TEST=postgresql://patrimoine:CHANGE_ME@127.0.0.1:5432/patrimoine_test
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
APP_ORIGIN=http://localhost:3000
# Facultatif : répertoire contenant pg_dump et pg_restore, sinon PATH.
# PGBIN=C:/Program Files/PostgreSQL/17/bin
POSTGRES_USER=patrimoine
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=patrimoine
# Secret aléatoire des routes Cron ; configurer aussi dans Vercel (Production).
CRON_SECRET=
# Clé API Zerion côté serveur uniquement, jamais NEXT_PUBLIC_.
ZERION_API_KEY=
